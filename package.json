{
  "name": "kadroskop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Диагностика потерь кадров и статтеров на Windows: статический аудит конфигурации + телеметрия кадров.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "release": "node scripts/build-release.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:release": "node scripts/release-desktop.mjs",
    "start:web": "node src/main/server.ts --open",
    "audit": "node src/main/cli.ts audit",
    "sensors": "node src/main/cli.ts sensors",
    "capture": "node src/main/cli.ts capture",
    "bench": "node src/main/cli.ts bench",
    "sessions": "node src/main/cli.ts sessions",
    "analyze": "node src/main/cli.ts analyze",
    "compare": "node src/main/cli.ts compare",
    "serve": "node src/main/server.ts",
    "dev": "node scripts/dev.mjs",
    "ui": "vite --config web/vite.config.ts",
    "ui:build": "vite build --config web/vite.config.ts",
    "sidecar:build": "dotnet publish sidecar/Kadroskop.Sidecar/Kadroskop.Sidecar.csproj -c Release -o sidecar/bin --nologo",
    "typecheck": "tsc --noEmit",
    "typecheck:ui": "tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "arch:ui": "cd web && depcruise src --config ../.dependency-cruiser.ui.cjs",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run typecheck:ui && npm run arch && npm run arch:ui && npm run test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"{src,desktop,web/src,tests,scripts}/**/*.{ts,tsx,js,mjs,cjs,css}\" \"*.{json,mjs,cjs,ts,md}\" \"web/*.{ts,json,html}\"",
    "format:check": "prettier --check \"{src,desktop,web/src,tests,scripts}/**/*.{ts,tsx,js,mjs,cjs,css}\" \"*.{json,mjs,cjs,ts,md}\" \"web/*.{ts,json,html}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "dependency-cruiser": "^16.10.0",
    "electron": "44.4.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uplot": "^1.6.32"
  }
}
